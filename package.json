    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.6.2",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "lefthook": "^2.1.4",
    "lint-staged": "^16.3.3",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
