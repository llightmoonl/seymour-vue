    "katex": "^0.16.28",
    "markdown-it": "^14.1.0",
    "markdown-it-katex": "^2.0.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sass-embedded": "^1.97.2",
    "universal-cookie": "^7.2.2",
    "vue": "^3.5.26",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
